{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "@cloudflare/workers-types"],
    "lib": ["es2023", "dom"]
  },
  "include": ["kit/*.ts", "*/alchemy.run.ts", "*/smoke.ts"]
}
