{
  "name": "port",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "workers_dev": false,
  "routes": [{ "pattern": "port.customer0.dev", "custom_domain": true }]
}
