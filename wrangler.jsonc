{
  "name": "port",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [{ "pattern": "port.customer0.dev", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "RECEIPTS", "id": "4ff2d79a6cae44e194d7706b31ff6bb9" }],
  "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Grant"] }]
}
